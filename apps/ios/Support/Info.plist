<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Dev servers speak plain HTTP on the local network (localhost from the
	     simulator, the Mac's LAN IP from a device). Everything else stays ATS. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- Standard HTTPS only (OpenRouter tutor calls) — the App Store export
	     compliance exemption. Declared here so every upload skips the manual
	     compliance question. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
