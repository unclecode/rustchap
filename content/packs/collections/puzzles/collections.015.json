        "text": "    values.dedup();\n"
      },
      {
        "id": "pop",
        "text": "    values.pop();\n"
      },
      {
        "id": "ret",
        "text": "    values"
      }
    ],
    "fixed_suffix": "\n}"
  },
  "evaluation": {
    "tests": [
      "#[test]\nfn trims_highest() {\n    assert_eq!(clean_and_trim(vec![5, 1, 5, 2]), vec![1, 2]);\n}",
      "#[test]\nfn handles_duplicates() {\n    assert_eq!(clean_and_trim(vec![4, 4, 4, 3]), vec![3]);\n}"
    ],
