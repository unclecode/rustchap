  "template": "use std::ffi::{c_char, CStr};\n\nunsafe extern \"C\" {\n    unsafe fn strlen(s: *const c_char) -> usize;\n}\n\nfn measure(s: ⟦type_slot⟧) -> usize {\n    unsafe { strlen(⟦arg_slot⟧) }\n}\n\nfn main() {\n    println!(\"{}\", measure(c\"hello\"));\n}\n",
